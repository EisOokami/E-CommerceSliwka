# ─── API ──────────────────────────────────────────────────────────────────────
# API address used by the Next.js server (server actions, loaders, /media rewrite).
API_URL=http://localhost:3001
# Fallback for API_URL used by the admin panel; leave empty to use API_URL.
ADMIN_API_ORIGIN=
# Public API address used by the browser for Google sign-in
# (<NEXT_PUBLIC_API_URL>/api/auth/google). Without it the Google button is hidden.
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── Client IP behind a reverse proxy ─────────────────────────────────────────
# Header with the real client IP set by the proxy in front of Next.js (e.g.
# x-real-ip). Forwarded to the API for rate limits. Leave empty without a proxy.
CLIENT_IP_HEADER=
# Same for the admin panel; used when CLIENT_IP_HEADER is empty.
ADMIN_CLIENT_IP_HEADER=

# ─── Legal documents (/privacy, /terms) ───────────────────────────────────────
# Public address of the store shown in the documents.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Versions shown on the pages; keep them equal to the API values.
TERMS_VERSION=1.0
PRIVACY_VERSION=1.0
# Dates shown in the documents, e.g. "20 listopada 2026 r.".
LEGAL_LAST_TERMS_UPDATED=
LEGAL_EFFECTIVE_TERMS_DATE=
LEGAL_LAST_PRIVACY_UPDATED=
LEGAL_EFFECTIVE_PRIVACY_DATE=
# Operator (data controller) and contact e-mail for legal and privacy matters.
LEGAL_OPERATOR=
LEGAL_CONTACT_EMAIL=
# Server provider and country, e.g. "Hetzner Online GmbH (Niemcy)".
LEGAL_SERVER_PROVIDER=
# Backup retention, e.g. "do 30 dni".
LEGAL_BACKUP_RETENTION=
# Stripe contracting entity (Stripe Dashboard → Settings → Business).
LEGAL_STRIPE_ENTITY=
# Repository and license links (defaults: github.com/EisOokami/ECommerceSliwka).
LEGAL_REPOSITORY_URL=
LEGAL_LICENSE_URL=
# Empty values show a highlighted [DO UZUPEŁNIENIA] placeholder on the pages.
