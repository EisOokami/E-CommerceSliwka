# ─── Runtime ──────────────────────────────────────────────────────────────────
# development | production (production enables secure cookies and stricter checks).
NODE_ENV=development
# Port of the API.
PORT=3001

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Apply the schema with `npm run db:initialize`
# (empty database) or `npm run db:migrate` (existing database).
DATABASE_URL=postgres://user:password@localhost:5432/sliwka

# ─── Secrets (generate long random values, e.g. `openssl rand -base64 48`) ────
# Sign customer access and refresh tokens.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Signs CSRF tokens.
CSRF_SECRET=
# Signs admin cookies; at least 32 characters.
COOKIE_SECRET=
# Base64-encoded 32-byte key that encrypts 2FA secrets: `openssl rand -base64 32`.
MFA_ENCRYPTION_KEY=

# ─── URLs, CORS and hosts ─────────────────────────────────────────────────────
# Public storefront URL: e-mail links, Google sign-in and Stripe return URLs.
FRONTEND_URL=http://localhost:3000
# Comma-separated origins allowed to call the store API.
CORS_URLS=http://localhost:3000
# Comma-separated host names (with port) the API answers to.
HOSTS=localhost:3001,127.0.0.1:3001
# Comma-separated exact origins allowed to call the admin API (HTTPS in production).
ADMIN_ORIGINS=http://localhost:3000
# Trusted proxies in front of the API (addresses or subnets, comma-separated,
# e.g. `loopback,172.18.0.0/16`). Only they may set X-Forwarded-For.
TRUST_PROXY=loopback
# Legacy alternative: number of trusted proxy hops. Spoofable if the API is
# reachable directly; prefer TRUST_PROXY.
TRUST_PROXY_HOPS=

# ─── Legal documents ──────────────────────────────────────────────────────────
# Required. Versions of the Terms of Service and Privacy Policy published at
# /terms and /privacy. After a bump every account has to accept the new versions.
# Keep them equal to the frontend values.
TERMS_VERSION=1.0
PRIVACY_VERSION=1.0

# ─── E-mail (Nodemailer) ──────────────────────────────────────────────────────
# Sender mailbox.
EMAIL_USER=
EMAIL_PASSWORD=
# Either a Nodemailer well-known service (e.g. gmail)...
EMAIL_SERVICE=gmail
# ...or any SMTP server (leave EMAIL_SERVICE empty). EMAIL_PORT defaults to 587;
# EMAIL_SECURE=true for implicit TLS (port 465).
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=

# ─── Google sign-in ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be registered in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# ─── Stripe (demo store: test mode only) ──────────────────────────────────────
# Test-mode secret key (sk_test_... or rk_test_...). The API refuses a live key.
# Leave empty to disable checkout.
STRIPE_KEY=
# true turns on Stripe Tax (makes Stripe ask for the customer's address).
STRIPE_AUTOMATIC_TAX=false
# Optional comma-separated Stripe shipping rate IDs.
STRIPE_SHIPPING_RATE_IDS=

# ─── AI helpers in the admin panel ────────────────────────────────────────────
GEMINI_API_KEY=
# Defaults to gemini-3.5-flash-lite.
GEMINI_MODEL=

# ─── Uploads ──────────────────────────────────────────────────────────────────
# Directory for uploaded images (default ./uploads).
UPLOAD_DIR=
# Maximum image size in bytes (default 5242880 = 5 MB).
MAX_IMAGE_BYTES=
